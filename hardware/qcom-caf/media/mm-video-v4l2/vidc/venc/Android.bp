cc_library_shared {
    name: "libOmxVenc",
    vendor: true,

    srcs: [
        "src/omx_video_base.cpp",
        "src/omx_video_encoder.cpp",
        "src/video_encoder_device_v4l2.cpp",
    ],

    cflags: [
        "-Werror",
        "-D_ANDROID_",
        "-D_ANDROID_ICS_",
        "-D_UBWC_",
        "-D_MSM8974_",
        "-DT_ARM",
        "-USINGLE_ENCODER_INSTANCE",
        "-DUSE_CAMERA_METABUFFER_UTILS",
        "-DUSE_ION",
        "-DUSE_NATIVE_HANDLE_SOURCE",
        "-DMASTER_CIDE_CP",
        "-DSUPPORT_CONFIG_INTRA_REFRESH",
        "-DLTR_SUPPORT",
        "-DUSE_CAMERA_METABUFFER_UTILS",
        "-DMAX_RES_1080P",
        "-DMAX_RES_1080P_EBI",
        "-DMAX_H264_LEVEL_52",
    ],

    include_dirs: [
        "system/memory/libion/include",
        "system/memory/libion/kernel-headers",
    ],

    header_libs: [
        "display_headers",
        "libc2dcolorconvert_headers",
        "libomxcommon_headers",
        "libomxcore_headers",
        "libomxvenc_headers",
        "libutils_headers",
        "libnativebase_headers",
        "libhardware_headers",
        "libstagefrighthw_headers",
        "media_plugin_headers",
        "qti_kernel_headers",
    ],

    shared_libs: [
        "libc2dcolorconvert",
        "libcutils",
        "libqdutils",
        "libion",
        "liblog",
        "libdl",
        "libqdMetaData",
    ],

    static_libs: [
        "libOmxVidcCommon",
    ],
}

cc_library_headers {
    name: "libomxvenc_headers",
    export_include_dirs: ["inc"],
    vendor: true,
}
